{
  "manifest_version": 3,
  "name": "ClauseRadar",
  "version": "1.0.0",
  "description": "Kullanım koşullarını, gizlilik politikasını ve abonelik şartlarını otomatik okur; riskleri birebir alıntılarla ve sesli uyarılarla raporlar. Hukuki tavsiye değildir.",
  "permissions": ["scripting", "sidePanel", "storage", "tabs", "offscreen", "tts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "ClauseRadar: Sonucu Göster" },
  "commands": {
    "read-result": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Bu sitenin sonucunu sesli oku" },
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+I" }, "description": "ClauseRadar panelini aç" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
